# ---- Server-only (apps/api, scripts). NEVER prefix with VITE_ ----
NODE_ENV=development
PORT=3101
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase session pooler) used by `pnpm db:migrate`
DATABASE_URL=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
# Model for the non-English compliance check (defaults to OPENAI_CHAT_MODEL)
OPENAI_JUDGE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retrieval thresholds calibrated by `pnpm calibrate` (see docs/retrieval-calibration.md)
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.26
RETRIEVAL_RELATIVE_MARGIN=0.04
RETRIEVAL_MIN_FUSED_SCORE=0.0162
RETRIEVAL_TOP_K=5

# Abuse protection
RATE_LIMIT_AI_PER_AGENT_PER_MIN=10
RATE_LIMIT_AI_PER_CONVERSATION_PER_MIN=5
REQUEST_TIMEOUT_MS=60000

# Ask for and verify the order number before answering order-related questions (off by default)
ORDER_GATE_ENABLED=false
ORDER_GATE_MAX_ATTEMPTS=3

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cx-ai-assistant

# Test mode: use deterministic mock LLM (CI only)
LLM_MODE=openai   # openai | mock

# ---- Demo data (pnpm db:seed) ----
# Password for the demo logins. Required to seed a hosted Supabase project, together with SEED_ALLOW_REMOTE.
# SEED_PASSWORD=choose-a-strong-password
# SEED_ALLOW_REMOTE=true

# ---- Browser-safe (apps/web) ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:3101

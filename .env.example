# ---- Server-only (apps/api, scripts). NEVER prefix with VITE_ ----
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for `supabase db push` (CLI uses SUPABASE_DB_PASSWORD) and SQL tests
DATABASE_URL=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Retrieval thresholds (uncalibrated defaults until scripts/calibrate-retrieval.ts is run with a real key)
RETRIEVAL_MIN_VECTOR_SIMILARITY=0.30
RETRIEVAL_MIN_FUSED_SCORE=0.015
RETRIEVAL_TOP_K=5

# Abuse protection
RATE_LIMIT_AI_PER_AGENT_PER_MIN=10
RATE_LIMIT_AI_PER_CONVERSATION_PER_MIN=5
REQUEST_TIMEOUT_MS=60000

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cx-ai-assistant

# Test mode: use deterministic mock LLM (CI only)
LLM_MODE=openai   # openai | mock

# ---- Browser-safe (apps/web) ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001
